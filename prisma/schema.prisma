// Prisma schema «Цифровой улей» — SQLite, один файл db/custom.db.
// Пользователи и роли (пасечник/помощник), справочник ульев и площадок,
// телеметрия датчиков, журнал событий, история чата с ИИ-агентом, настройки.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  BEEKEEPER
  HELPER
}

model User {
  id            String     @id @default(cuid())
  name          String     @unique
  email         String?    @unique // email для подтверждения регистрации; null — старые/демо-аккаунты
  emailVerified DateTime?  // дата подтверждения email; null — аккаунт ещё не подтверждён
  passwordHash  String
  role          Role       @default(HELPER)
  displayName   String?    // имя, как его видит пользователь в интерфейсе
  avatar        String?    // фото профиля: data-URL (JPEG, 256px)
  createdAt     DateTime   @default(now())
  sessions            Session[]
  reminders           Reminder[]
  apiaryPoints        ApiaryPoint[]
  verificationTokens  VerificationToken[]
  sensorLogs          SensorLog[]
  chatSessions        ChatSession[]
}

/** Одноразовый токен/код подтверждения email: в БД хранится только SHA-256 хеш. */
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
}

model Hive {
  id           String        @id @default(cuid())
  number       Int           @unique
  name         String
  familyNote   String        @default("")
  createdAt    DateTime      @default(now())
  measurements Measurement[]
  events       Event[]
  chatMessages ChatMessage[]
  reminders    Reminder[]
}

model Measurement {
  id          String   @id @default(cuid())
  hiveId      String
  hive        Hive     @relation(fields: [hiveId], references: [id], onDelete: Cascade)
  ts          DateTime
  weightKg    Float?
  tempC       Float?
  humidityPct Float?
  source      String   @default("manual") // manual | csv | api
  createdAt   DateTime @default(now())

  @@index([hiveId, ts])
}

model MigrationSite {
  id          String   @id @default(cuid())
  name        String
  honeyPlant  String   @default("")
  bloomWindow String   @default("")
  distanceKm  Float    @default(0)
  weatherNote String   @default("")
  risks       String   @default("")
  score       Float    @default(5)
  verdict     String   @default("backup") // recommend | backup | avoid
  createdAt   DateTime @default(now())
}

model Event {
  id         String   @id @default(cuid())
  hiveId     String
  hive       Hive     @relation(fields: [hiveId], references: [id], onDelete: Cascade)
  ts         DateTime
  type       String   // осмотр | подкормка | расширение | лечение | кочёвка | прочее
  note       String
  authorName String
  createdAt  DateTime @default(now())

  @@index([hiveId, ts])
}

/** Отдельный чат с ИИ-агентом: у каждого пользователя свой список чатов. */
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Новый чат") // заголовок — первые слова первого вопроса
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // трогается при добавлении сообщений
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String       @id @default(cuid())
  hiveId    String?      // null — общие вопросы (погода, кочёвка, пестициды)
  hive      Hive?        @relation(fields: [hiveId], references: [id], onDelete: Cascade)
  role      String       // user | agent
  text      String
  agentJson String?      // сериализованный AgentMessage для ответов агента
  author    String?
  userId    String?      // автор-пользователь: чаты каждого — только его
  sessionId String?      // чат-сессия; null — старые сообщения общей ленты
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([hiveId, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
}

model Reminder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiveId     String?
  hive       Hive?     @relation(fields: [hiveId], references: [id], onDelete: SetNull)
  text       String
  remindAt   DateTime
  allDay     Boolean   @default(false) // заметка без времени — «в течение дня»
  done       Boolean   @default(false)
  doneAt     DateTime?
  notifiedAt DateTime? // когда приложение показало оповещение
  createdAt  DateTime  @default(now())

  @@index([userId, remindAt])
}

model AppSetting {
  key   String @id
  value String
}

/** Точка пасеки на карте: улей и датчик внутри.
 *  Улей привязывается по коду датчика — координаты задаёт GPS самого датчика.
 *  Датчик жёстко привязан к номеру улья (hiveNumber); от типа датчика
 *  (контактный/инфракрасный) и места установки (центр гнезда/периферия)
 *  сильно зависят показания температуры и влажности. */
model ApiaryPoint {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  lat             Float
  lon             Float
  hiveCount       Int      @default(1)   // сколько ульев в этой точке (сейчас — всегда 1)
  hiveNumber      Int? // номер улья на корпусе — «Улей №ХХХ» в интерфейсе
  hasSensor       Boolean  @default(true) // датчик привязывается по коду автоматически
  sensorOn        Boolean  @default(true) // датчик включён / выключен
  sensorCode      String? // код датчика на корпусе, по которому привязан улей
  sensorKind      String   @default("contact") // contact — контактный | ir — инфракрасный
  sensorPlacement String   @default("center") // center — центр гнезда | periphery — периферия клуба/расплода
  cameraUrl       String? // URL снимка/потока камеры наблюдения на точке (MJPEG/HTTP-снапшот)
  createdAt       DateTime @default(now())
  sensorLogs      SensorLog[]

  @@index([userId, createdAt])
}

/** Поле медоноса — данные Минсельхоза области (справочник для кочёвки).
 *  Посевная площадь, фактическая дата посева (от неё рассчитывается
 *  начало цветения), кратность и класс опасности обработок пестицидами.
 *  Медопродуктивность га и норма семей — справочные нормативы
 *  НИИ пчеловодства (Рыбново) — хранятся в коде (agro-catalog.ts). */
model CropField {
  id             String    @id @default(cuid())
  ownerKey       String    @default("minselhoz") // minselhoz — региональный справочник; иначе имя пользователя
  culture        String // ключ культуры: buckwheat | linden | melilot | sunflower | sainfoin | phacelia | coriander
  name           String // название поля / массива
  district       String    @default("") // район области
  areaHa         Float     @default(0) // посевная площадь, га
  lat            Float?
  lon            Float?
  sowingDate     DateTime? // фактическая дата посева по отчёту Минсельхоза
  distanceKm     Float     @default(0) // расстояние от пасеки, км
  treatmentsJson String    @default("[]") // обработки: [{date, drug, hazardClass, note}]
  createdAt      DateTime  @default(now())

  @@index([ownerKey])
}

/** Почасовой журнал показаний датчика улья — источник раздела «История событий».
 *  Записи генерируются по якорным точкам CSV-выгрузки (8:00 и 20:00) с
 *  почасовой интерполяцией: параметры фиксируются каждый час. */
model SensorLog {
  id          String      @id @default(cuid())
  pointId     String
  point       ApiaryPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt  DateTime
  weightKg    Float
  tempC       Float
  humidityPct Float
  source      String      @default("csv") // csv — по выгрузке телеметрии

  @@index([userId, recordedAt])
  @@index([pointId, recordedAt])
}
